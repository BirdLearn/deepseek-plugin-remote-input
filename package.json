{
  "name": "dsh-remote-input",
  "version": "1.0.0",
  "description": "Send text and photos from a phone into the DeepSeek Harness composer by scanning a QR code.",
  "license": "MIT",
  "author": "BirdLearn",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "bundle",
    "qrcode",
    "composer",
    "remote-input",
    "mobile"
  ],
  "homepage": "https://github.com/BirdLearn/deepseek-plugin-remote-input#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BirdLearn/deepseek-plugin-remote-input.git"
  },
  "bugs": {
    "url": "https://github.com/BirdLearn/deepseek-plugin-remote-input/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "config.js",
    "mobile-page.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
